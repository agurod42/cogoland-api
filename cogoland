#!/usr/bin/env python3
import argparse
import json
import os
import urllib.request
import urllib.error
from pathlib import Path

BASE_URL = "https://api.nfcogos.com"
CONFIG_DIR = Path.home() / ".config" / "cogoland"
TOKEN_FILE = CONFIG_DIR / "token"


def get_token():
    env = os.environ.get("COGOLAND_TOKEN")
    if env:
        return env.strip()
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    return None


def request_json(method, path, data=None, token=None):
    url = BASE_URL + path
    body = None
    headers = {"Accept": "application/json"}
    if data is not None:
        body = json.dumps(data).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            print(resp.status)
            print(raw.decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        print(exc.code)
        print(exc.read().decode("utf-8", "replace"))
    except urllib.error.URLError as exc:
        raise SystemExit("Request failed: " + str(exc.reason))


def cmd_token_set(args):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TOKEN_FILE.write_text(args.token.strip() + "\n")
    os.chmod(TOKEN_FILE, 0o600)
    print("Token stored in " + str(TOKEN_FILE))


def cmd_token_show(args):
    token = get_token()
    if token:
        print("A token is configured.")
    else:
        print("No token is configured.")


def cmd_request(args):
    token = get_token()
    data = None
    if args.data:
        try:
            data = json.loads(args.data)
        except json.JSONDecodeError:
            raise SystemExit("Invalid JSON in --data")
    request_json(args.method.upper(), args.path, data=data, token=token)


def main():
    parser = argparse.ArgumentParser(prog="cogoland")
    sub = parser.add_subparsers(required=True, dest="command")

    token = sub.add_parser("token")
    token_sub = token.add_subparsers(required=True, dest="token_command")
    set_parser = token_sub.add_parser("set")
    set_parser.add_argument("token")
    set_parser.set_defaults(func=cmd_token_set)
    show_parser = token_sub.add_parser("show")
    show_parser.set_defaults(func=cmd_token_show)

    req = sub.add_parser("request")
    req.add_argument("method")
    req.add_argument("path")
    req.add_argument("--data")
    req.set_defaults(func=cmd_request)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
